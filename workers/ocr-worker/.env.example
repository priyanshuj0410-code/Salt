# Salt OCR worker — copy to .env and fill in. .env is GITIGNORED; the service-role
# key is powerful (bypasses RLS) and must never be committed or put in apps/web.

# --- Supabase (the laptop talks straight to the project, PRD §7 v1) -----------
SUPABASE_URL=https://<project-ref>.supabase.co
# Settings -> API -> Project API keys -> service_role (secret). Laptop only.
SUPABASE_SERVICE_KEY=

# --- Ollama (runs on THIS laptop, so no tunnel / exposed port) ----------------
OLLAMA_HOST=http://localhost:11434
# The vision tag you pulled. Size per machine (see README):
#   M4 / 24 GB  -> larger variant (burst worker)   e.g. gemma3:12b
#   Intel/16 GB -> smallest variant (always-on)     e.g. gemma3:4b
OCR_MODEL=gemma3:12b

# --- Worker identity / tuning -------------------------------------------------
# Unique per machine. Blank -> <hostname>-<pid>.
WORKER_ID=
# Lanes to drain: 'queue' = free local lane. Add 'flash' to also drain escalations
# locally instead of paying Gemini (OCR_LANES=queue,flash).
OCR_LANES=queue
LEASE_SECONDS=300
POLL_INTERVAL_MS=5000
CONCURRENCY=1
OCR_BUCKET=invoice-scans
MAX_IMAGE_PX=1500
