# Supabase — copy this file to .env.local and fill in your project values.
# Both values are safe to expose in a frontend bundle (the anon key is public).
# Find them in Supabase: Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Feature flags. Off unless set to "1".
# VITE_LENS_V2 — SALT-2 capability-lens spine (WS1) spike. When "1", the route
# gate + nav surfaces derive from deriveLens() instead of the role-default matrix.
VITE_LENS_V2=0
